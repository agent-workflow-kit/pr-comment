    "inline_comment": {
      "type": "object",
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/finding_id"
        },
        "path": {
          "type": "string",
          "x-untrusted": true,
          "description": "Untrusted: the file's path at the pinned head, as forgectl prints it.",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "start_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "role": {
          "type": "string",
          "pattern": "^inline:[A-Za-z0-9._-]{1,64}$",
          "description": "inline:<finding id>: the bodies entry holding this comment's text."
        }
      },
      "additionalProperties": false,
      "required": [
        "finding_id",
        "path",
        "line",
        "start_line",
        "side",
        "role"
      ]
    },
    "plan_body": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^(?:body|inline:[A-Za-z0-9._-]{1,64})$",
          "description": "body, or inline:<finding id>."
        },
        "text": {
          "type": "string",
          "x-untrusted": true,
          "description": "Untrusted: the body as handed to forgectl (the Text pipeline's output), without forgectl's dedupe line."
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "text",
        "bytes"
      ]
    },
    "follow_up": {
      "type": "object",
      "properties": {
        "action": {
          "const": "resolve"
        },
        "thread_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/thread_id"
            },
            {
              "type": "null"
            }
          ],
          "description": "The GitLab body thread; null when it is known only after the post."
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "thread_id"
      ],
      "description": "A forgectl write that follows the post (the GitLab body-thread resolve)."
    },
    "plan": {
      "type": "object",
      "properties": {
        "plan_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256 of the canonical JSON of the plan's posting content (interface, Posting plan)."
        },
        "bodies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plan_body"
          },
          "minItems": 1
        },
        "inline_comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline_comment"
          },
          "description": "review only; empty otherwise."
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "minItems": 1,
          "description": "The real forgectl calls the run would execute (with --yes), in order; not the pre-check. The input goes on stdin."
        },
        "follow_ups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/follow_up"
          },
          "description": "pr-comment's own follow-up writes (the GitLab body-thread resolve), in write order."
        }
      },
      "additionalProperties": false,
      "required": [
        "plan_sha256",
        "bodies",
        "inline_comments",
        "commands",
        "follow_ups"
      ],
      "description": "What a real run would post: the confirmed plan."
    },
    "hook_entry_pre": {
      "type": "object",
      "properties": {
        "cmd": {
          "type": "string",
          "minLength": 1,
          "description": "Run through sh -c in its own process group."
        },
        "timeout": {
          "$ref": "#/$defs/duration",
          "default": "30s"
        },
        "with_text": {
          "type": "boolean",
          "default": false,
          "description": "Add each body's final text to the payload's bodies."
        }
      },
      "additionalProperties": false,
      "required": [
        "cmd"
      ],
      "description": "Exit 0 continues; 13 escalates; any other non-zero exit or a timeout vetoes."
    },
    "hook_entry_post": {
      "type": "object",
      "properties": {
        "cmd": {
          "type": "string",
          "minLength": 1,
          "description": "Run through sh -c in its own process group."
        },
        "timeout": {
          "$ref": "#/$defs/duration",
          "default": "30s"
        },
        "async": {
          "type": "boolean",
          "default": false,
          "description": "Run detached under a watchdog that enforces its timeout."
        },
        "with_text": {
          "type": "boolean",
          "default": false,
          "description": "Add each body's final text to the payload's bodies."
        }
      },
      "additionalProperties": false,
      "required": [
        "cmd"
      ],
      "description": "Cannot undo; failures are logged and warned, never fatal."
    }
  }
}
